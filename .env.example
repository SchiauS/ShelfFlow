# --- ShelfFlow configuration (copy to .env) ---
NODE_ENV=development
PORT=3000
BASE_PATH=/projects/shelfflow

# PostgreSQL
POSTGRES_DB=shelfflow
POSTGRES_USER=shelfflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shelfflow:change-me@localhost:5432/shelfflow

# Sessions
SESSION_SECRET=replace-with-32-random-bytes
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Loans
LOAN_PERIOD_DAYS=14

# Uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=2097152

# Open Library
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_USER_AGENT=ShelfFlow/1.0 (contact@example.com)
OPEN_LIBRARY_TIMEOUT_MS=6000

# Demo seed (never reuse in production)
SEED_PASSWORD=ShelfFlow!Demo2026
