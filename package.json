{
  "name": "shelfflow",
  "private": true,
  "version": "1.0.0",
  "description": "ShelfFlow — library management system (Express + PostgreSQL + React)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
